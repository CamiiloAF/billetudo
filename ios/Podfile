# Patrol e2e needs the Podfile's deployment target to match Xcode's Build
# Settings for every target (Runner, RunnerTests, RunnerUITests) — a mismatch
# is the #1 cause of "iOS deployment version" build failures per Patrol's FAQ.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Debug-dev' => :debug,
  'Debug-prod' => :debug,
  'Profile' => :release,
  'Profile-dev' => :release,
  'Profile-prod' => :release,
  'Release' => :release,
  'Release-dev' => :release,
  'Release-prod' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end

  # Patrol e2e (patrol.leancode.co/documentation → iOS setup): the UI test
  # bundle needs every pod Runner has — including `patrol` itself, whose
  # native side (PATROL_INTEGRATION_TEST_IOS_RUNNER) RunnerUITests.m links
  # against — so it inherits `:complete` rather than just `:search_paths`.
  target 'RunnerUITests' do
    inherit! :complete
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # permission_handler compiles each iOS permission in at BUILD time from
    # GCC_PREPROCESSOR_DEFINITIONS. `permission_handler_apple` defaults
    # PERMISSION_MICROPHONE to 0 (PermissionHandlerEnums.h), and with it off
    # Permission.microphone resolves to UnknownPermissionStrategy: status is
    # always `denied` and request() answers `permanentlyDenied` with no system
    # prompt, even when the microphone is already allowed in Settings. Voice
    # capture (docs/requirements/fase-2/17-captura-voz.md) then dead-ends on
    # "open settings" and never listens on iOS.
    #
    # Only the microphone is enabled on purpose: speech-recognition
    # authorization is requested by `speech_to_text` itself (its
    # NSSpeechRecognitionUsageDescription is already in Info.plist), and the
    # app uses no other permission_handler group. Guarded by
    # test/ios/voice_capture_ios_config_test.dart and proven on a simulator by
    # integration_test/ios_microphone_permission_test.dart.
    next unless target.name == 'permission_handler_apple'

    target.build_configurations.each do |config|
      definitions =
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      definitions = [definitions] if definitions.is_a?(String)
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] =
        (definitions + ['PERMISSION_MICROPHONE=1']).uniq
    end
  end
end
