  "tutorialScheduledPaymentsPoint2Heading": "Automático o manual",
  "@tutorialScheduledPaymentsPoint2Heading": {},
  "tutorialScheduledPaymentsPoint2Body": "Uno automático se registra solo en su fecha. Uno manual te avisa y tú confirmas antes de que cuente (útil si el monto cambia cada vez).",
  "@tutorialScheduledPaymentsPoint2Body": {},
  "tutorialScheduledPaymentsPoint3Heading": "La bandeja de vencimientos",
  "@tutorialScheduledPaymentsPoint3Heading": {},
  "tutorialScheduledPaymentsPoint3Body": "Ahí ves todos tus pagos pendientes en un solo lugar y los confirmas cuando te llegan.",
  "@tutorialScheduledPaymentsPoint3Body": {},
  "tutorialScheduledPaymentsCta": "Programar mi primer pago",
  "@tutorialScheduledPaymentsCta": {},
  "tutorialDebtLinkMovementTitle": "Enlazar un movimiento existente",
  "@tutorialDebtLinkMovementTitle": {},
  "tutorialDebtLinkMovementPoint1Heading": "No crea un movimiento nuevo",
  "@tutorialDebtLinkMovementPoint1Heading": {},
  "tutorialDebtLinkMovementPoint1Body": "Atribuye uno que ya registraste, para no duplicar.",
  "@tutorialDebtLinkMovementPoint1Body": {},
  "tutorialGoalLinkMovementTitle": "Enlazar un movimiento existente",
  "@tutorialGoalLinkMovementTitle": {},
  "tutorialGoalLinkMovementPoint1Heading": "No crea un movimiento nuevo",
  "@tutorialGoalLinkMovementPoint1Heading": {},
  "tutorialGoalLinkMovementPoint1Body": "Atribuye uno que ya registraste, para no duplicar.",
  "@tutorialGoalLinkMovementPoint1Body": {},
  "tutorialDebtPaymentToggleTitle": "¿Agregar el abono a una cuenta?",
  "@tutorialDebtPaymentToggleTitle": {},
  "tutorialDebtPaymentTogglePoint1Heading": "Si eliges \"Sí\"",
  "@tutorialDebtPaymentTogglePoint1Heading": {},
  "tutorialDebtPaymentTogglePoint1Body": "El abono también descuenta el monto de la cuenta que elijas, como una transacción real.",
  "@tutorialDebtPaymentTogglePoint1Body": {},
  "tutorialDebtPaymentTogglePoint2Heading": "Si eliges \"No\"",
  "@tutorialDebtPaymentTogglePoint2Heading": {},
  "tutorialDebtPaymentTogglePoint2Body": "La deuda baja igual, pero no se toca ningún saldo (útil si pagaste en efectivo o alguien más pagó por ti).",
  "@tutorialDebtPaymentTogglePoint2Body": {},
  "tutorialGoalContributionToggleTitle": "¿Mover dinero de una cuenta?",
  "@tutorialGoalContributionToggleTitle": {},
  "tutorialGoalContributionTogglePoint1Heading": "Si eliges \"Sí\"",
  "@tutorialGoalContributionTogglePoint1Heading": {},
  "tutorialGoalContributionTogglePoint1Body": "El aporte descuenta el monto real de una cuenta, como una transferencia.",
  "@tutorialGoalContributionTogglePoint1Body": {},
  "tutorialGoalContributionTogglePoint2Heading": "Si eliges \"No\"",
  "@tutorialGoalContributionTogglePoint2Heading": {},
  "tutorialGoalContributionTogglePoint2Body": "El aporte solo queda anotado en la meta, sin tocar ningún saldo (útil si ya guardaste ese dinero en otro lado).",
  "@tutorialGoalContributionTogglePoint2Body": {},
  "tutorialDebtScheduledInstallmentTitle": "La cuota vive en Pagos programados",
  "@tutorialDebtScheduledInstallmentTitle": {},
  "tutorialDebtScheduledInstallmentPoint1Heading": "Se configura aquí, se confirma allá",
  "@tutorialDebtScheduledInstallmentPoint1Heading": {},
  "tutorialDebtScheduledInstallmentPoint1Body": "La configuras desde esta deuda, pero se confirma desde la bandeja de Pagos programados, como cualquier otro pago.",
  "@tutorialDebtScheduledInstallmentPoint1Body": {},
  "tutorialDebtScheduledInstallmentPoint2Heading": "Un solo movimiento, dos efectos",
  "@tutorialDebtScheduledInstallmentPoint2Heading": {},
  "tutorialDebtScheduledInstallmentPoint2Body": "Al confirmarla, un solo movimiento baja el saldo de tu cuenta y abona a la deuda al mismo tiempo.",
  "@tutorialDebtScheduledInstallmentPoint2Body": {},
  "tutorialBudgetableTransferTitle": "¿Contar esta transferencia en tu presupuesto?",
  "@tutorialBudgetableTransferTitle": {},
  "tutorialBudgetableTransferPoint1Heading": "Para qué sirve marcarla",
  "@tutorialBudgetableTransferPoint1Heading": {},
  "tutorialBudgetableTransferPoint1Body": "Algunas transferencias sí son parte de tu plan de gasto, aunque no sean un gasto real (por ejemplo, mover dinero a la cuenta que usas para gastar en el mes).",
  "@tutorialBudgetableTransferPoint1Body": {},
  "tutorialBudgetableTransferPoint2Heading": "Qué cambia al marcarla",
  "@tutorialBudgetableTransferPoint2Heading": {},
  "tutorialBudgetableTransferPoint2Body": "Se resta de tu presupuesto igual que un gasto, aunque el dinero siga siendo tuyo, solo que en otra cuenta.",
  "@tutorialBudgetableTransferPoint2Body": {},
  "tutorialEnvelopeModeTitle": "Así funciona el modo sobres",
  "@tutorialEnvelopeModeTitle": {},
  "tutorialEnvelopeModePoint1Heading": "Para qué sirve",
  "@tutorialEnvelopeModePoint1Heading": {},
  "tutorialEnvelopeModePoint1Body": "Reparte todo tu ingreso entre tus categorías, para que cada peso ya tenga un destino desde el inicio.",
  "@tutorialEnvelopeModePoint1Body": {},
  "tutorialEnvelopeModePoint2Heading": "Qué cambia en la pantalla",
  "@tutorialEnvelopeModePoint2Heading": {},
  "tutorialEnvelopeModePoint2Body": "En vez de un solo monto libre, ves cuánto le queda a cada categoría por separado.",
  "@tutorialEnvelopeModePoint2Body": {},
  "tutorialBudgetFeaturedChoiceTitle": "Elige qué presupuesto destacar",
  "@tutorialBudgetFeaturedChoiceTitle": {},
  "tutorialBudgetFeaturedChoicePoint1Heading": "Uno a la vez en Inicio",
  "@tutorialBudgetFeaturedChoicePoint1Heading": {},
  "tutorialBudgetFeaturedChoicePoint1Body": "El presupuesto destacado es el que ves en la portada de Inicio. Ahora que tienes más de uno, puedes elegir cuál.",
  "@tutorialBudgetFeaturedChoicePoint1Body": {},
  "tutorialBudgetFeaturedChoicePoint2Heading": "Cámbialo cuando quieras",
  "@tutorialBudgetFeaturedChoicePoint2Heading": {},
  "tutorialBudgetFeaturedChoicePoint2Body": "Entra a un presupuesto y usa el menú ⋮ para marcarlo como destacado o quitarlo. Es reversible en cualquier momento.",
  "@tutorialBudgetFeaturedChoicePoint2Body": {}
}
