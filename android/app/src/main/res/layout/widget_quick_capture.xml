<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget de captura rápida (docs/requirements/fase-2/20-widget-captura-rapida.md).

  Una sola fila de hasta 4 atajos, en 4 slots genéricos. `QuickCaptureWidgetProvider`
  decide en tiempo de render qué atajo va en cada slot (según la configuración
  guardada por instancia, HU-03) y esconde los que no caben en el ancho
  disponible (HU-06): Android redimensiona en un rango continuo, así que se
  muestran menos atajos en vez de apretarlos por debajo del área tocable
  mínima. Por eso ningún slot lleva ya un ícono/etiqueta fijo en el XML — se
  asignan con `RemoteViews.setImageViewResource`/`setTextViewText`.

  No muestra ningún dato financiero — es un atajo puro (decisión de alcance
  2026-08-17), así que no hay nada que refrescar ni que pueda quedar viejo.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/widget_shortcut_slot_0"
        style="@style/WidgetShortcut">

        <ImageView
            android:id="@+id/widget_shortcut_icon_0"
            style="@style/WidgetShortcutIcon" />

        <TextView
            android:id="@+id/widget_shortcut_label_0"
            style="@style/WidgetShortcutLabel" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_shortcut_slot_1"
        style="@style/WidgetShortcut">

        <ImageView
            android:id="@+id/widget_shortcut_icon_1"
            style="@style/WidgetShortcutIcon" />

        <TextView
            android:id="@+id/widget_shortcut_label_1"
            style="@style/WidgetShortcutLabel" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_shortcut_slot_2"
        style="@style/WidgetShortcut">

        <ImageView
            android:id="@+id/widget_shortcut_icon_2"
            style="@style/WidgetShortcutIcon" />

        <TextView
            android:id="@+id/widget_shortcut_label_2"
            style="@style/WidgetShortcutLabel" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_shortcut_slot_3"
        style="@style/WidgetShortcut">

        <ImageView
            android:id="@+id/widget_shortcut_icon_3"
            style="@style/WidgetShortcutIcon" />

        <TextView
            android:id="@+id/widget_shortcut_label_3"
            style="@style/WidgetShortcutLabel" />
    </LinearLayout>
</LinearLayout>
